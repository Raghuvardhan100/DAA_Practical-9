#include <iostream>
#include <vector>
#include <queue>

using namespace std;

// Pair format: {weight, vertex}
typedef pair<int, int> pii;

// Function to find the Minimum Spanning Tree using Prim's Algorithm
int primMST(int V, const vector<vector<pii>>& adj) {
    // Min-heap to store pairs of {edge_weight, vertex}
    priority_queue<pii, vector<pii>, greater<pii>> pq;
    
    // Array to track vertices included in the MST
    vector<bool> visited(V, false);
    
    int total_weight = 0;
    
    // Start with vertex 0 (weight is 0)
    pq.push({0, 0});
    
    while (!pq.empty()) {
        auto [weight, u] = pq.top();
        pq.pop();
        
        // If the vertex is already part of the MST, skip it
        if (visited[u]) continue;
        
        // Add the weight to the MST sum and mark the vertex as visited
        visited[u] = true;
        total_weight += weight;
        
        // Explore all neighbors of vertex u
        for (const auto& neighbor : adj[u]) {
            int v = neighbor.first;
            int next_weight = neighbor.second;
            
            // If neighbor v is not yet in the MST, push it to the queue
            if (!visited[v]) {
                pq.push({next_weight, v});
            }
        }
    }
    
    return total_weight;
}

int main() {
    int V = 5; // Number of vertices
    vector<vector<pii>> adj(V);

    // Graph defined as: u -> {v, weight}
    // Undirected graph requires adding edges in both directions
    auto addEdge = [&](int u, int v, int w) {
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    };

    addEdge(0, 1, 2);
    addEdge(0, 3, 6);
    addEdge(1, 2, 3);
    addEdge(1, 3, 8);
    addEdge(1, 4, 5);
    addEdge(2, 4, 7);
    addEdge(3, 4, 9);

    int mst_weight = primMST(V, adj);
    cout << "Total Weight of Minimum Spanning Tree: " << mst_weight << endl;

    return 0;
}
